# ── Сервер ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Адреса фронтенда через запятую (CORS и ссылки в письмах берут первый).
FRONTEND_URL=http://localhost:5173
# Публичный адрес API: нужен для ссылок в письмах и страницы тестовой оплаты.
PUBLIC_API_URL=http://localhost:3000
# Сколько прокси стоит перед API (nginx, балансировщик). Нужно для верного IP клиента.
# В продакшене обязателен: без него API не стартует (0 — если прокси нет).
TRUST_PROXY=0
LOG_LEVEL=debug
# Swagger UI на /api/docs. В продакшене обычно выключен.
SWAGGER_ENABLED=true

# ── База данных ─────────────────────────────────────────
DATABASE_URL=postgresql://impulse:impulse@localhost:5440/impulse
# Используется только e2e-тестами.
TEST_DATABASE_URL=postgresql://impulse:impulse@localhost:5440/impulse_test

# ── Авторизация ─────────────────────────────────────────
# Минимум 32 символа. Сгенерировать: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30

# ── Магазин ─────────────────────────────────────────────
SHOP_TIMEZONE=Europe/Moscow
# Базовый адрес фото: /media/<slug>/<n>-<w>.<ext>. Пусто или «/» — тот же домен, что у фронта.
MEDIA_BASE_URL=/
# Фото, загруженные в админке: папка на диске и публичный адрес (API раздаёт их сам).
UPLOADS_DIR=uploads
UPLOADS_BASE_URL=/api/uploads/
# Сколько минут держать резерв товара под неоплаченный заказ.
PAYMENT_TIMEOUT_MINUTES=30

# ── Оплата ──────────────────────────────────────────────
# mock — тестовая страница оплаты без реальных денег; yookassa — боевой шлюз.
PAYMENT_PROVIDER=mock
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Передавать в ЮKassa данные для чека по 54-ФЗ.
YOOKASSA_SEND_RECEIPT=false
# Код ставки НДС для чека (1 — без НДС, 4 — 20%). См. документацию ЮKassa.
YOOKASSA_VAT_CODE=1
# Проверять, что вебхук пришёл с IP-адресов ЮKassa.
YOOKASSA_CHECK_WEBHOOK_IP=true

# ── Почта ───────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Импульс <hello@impulse.store>"

# ── Первый администратор (создаётся сидом) ──────────────
SEED_ADMIN_EMAIL=admin@impulse.store
SEED_ADMIN_PASSWORD=Admin12345!
